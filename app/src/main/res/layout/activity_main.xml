<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="32dp"
        android:paddingTop="56dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejercicios UT3 - PMDM"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnEj1"
            android:backgroundTint="#03A9F4"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Ejercicio 1: Validar URL" />

        <Button
            android:id="@+id/btnEj2"
            android:backgroundTint="#03A9F4"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Ejercicio 2: Navegación retrasada (10s)" />

        <Button
            android:id="@+id/btnEj3"
            android:backgroundTint="#03A9F4"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Ejercicio 3: LinearLayouts Anidados" />

        <Button
            android:id="@+id/btnEj4"
            android:backgroundTint="#03A9F4"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Ejercicio 4: Mosaico FrameLayout" />

        <Button
            android:id="@+id/btnEj5"
            android:backgroundTint="#03A9F4"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Ejercicio 5: Calculadora (TableLayout)" />

        <Button
            android:id="@+id/btnEj6"
            android:backgroundTint="#03A9F4"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Ejercicio 6: Perfil (ConstraintLayout)" />

    </LinearLayout>
</ScrollView>